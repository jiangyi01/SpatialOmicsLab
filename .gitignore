# User-created tool repos and runtime files
agent/tools_user/repos/
agent/tools_user/*.lock
agent/tools_user/usage_log.jsonl
agent/tools_user/*_env.yaml
agent/tools_user/*_requirements.txt
agent/tools_user/install_log.json
agent/tools_user/__pycache__/
# Runtime state written by the tracked knowledge_manager.py / memory_manager.py. Ignored as
# directories, not shape-by-shape, so the next file written there is covered too. Nothing in them
# is authored by hand; the seeded content is reproducible via
# `cd agent && SOG_MEMORY_ENABLED=true python -m tools_user.seed_tool_creation_memory`.
# .memory/.secret is a per-install HMAC key (secrets.token_hex(32), mode 400) and must never be
# committed -- it was untracked AND unignored before this rule existed.
agent/tools_user/.knowledge/
agent/tools_user/.memory/
agent/MCP_server/mcp_config_user.yaml
agent/MCP_server/mcp_config_user.yaml.bak_*
tmp_install_*

