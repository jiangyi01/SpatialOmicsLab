# directory: `/test/` at the end of this file ignores the whole tree, so git never descends into it
# and no re-include under it can take effect. The list is in the history of this file at b3b7239a.

# Input data: STAGE's upstream loader writes input_data/used_gene.txt relative to its working directory.
agent/spatialomicsgym/input_data/
