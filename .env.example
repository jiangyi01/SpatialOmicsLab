# =============================================================================
# SpatialOmicsLab environment configuration
#
# Copy this file to .env and fill in the values for the ONE provider you use:
#     cp .env.example .env
# Or just run `sog-setup` -- the guided wizard writes .env for you (validating the
# key with a live ping) and never asks you to paste a secret into a chat.
#
# Only the two SOG_* lines plus your chosen provider's key block are required;
# every other block below is optional and commented out. Never commit your real .env.
# =============================================================================

# --- Which model to use ------------------------------------------------------
# SOG_SOURCE selects the provider; SOG_LLM names the model. SOG_SOURCE must be
# one of: Anthropic | OpenAI | AzureOpenAI | Gemini | Groq | Bedrock | Custom | Ollama
SOG_SOURCE=AzureOpenAI
SOG_LLM=azure-gpt-6-astra

# --- Provider key: Azure OpenAI (default) ------------------------------------
# Azure Portal -> your OpenAI resource -> Keys and Endpoint.
# SOG_LLM's azure- prefix selects the provider; the rest (gpt-6-astra) is your Azure
# *deployment* id -- change it if your deployment is named differently. gpt-6-astra is the
# shipped default (config.py) and the deployment name sog-setup writes; this line used to say
# gpt-5.5, so a copied template and the wizard targeted different deployments (hunt 2026-09-30,
# uL5-drift-7). The deployment comes from SOG_LLM, never from the endpoint URL's path.
# gpt-5* deployments are routed via the Responses API automatically.
OPENAI_API_KEY=...
OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# OPENAI_API_VERSION=2024-12-01-preview
# OPENAI_USE_RESPONSES_API=false          # set true only to opt a pre-gpt-5 deployment into the Responses API

# --- Provider: Anthropic -----------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
# SOG_SOURCE=Anthropic
# SOG_LLM=claude-opus-4-8
# ANTHROPIC_API_KEY=sk-ant-...

# --- Provider: OpenAI --------------------------------------------------------
# SOG_SOURCE=OpenAI
# SOG_LLM=gpt-4o                          # gpt-5* is routed via the Responses API automatically
# OPENAI_API_KEY=sk-...

# --- Provider: Google Gemini -------------------------------------------------
# SOG_SOURCE=Gemini
# SOG_LLM=gemini-2.0-flash
# GEMINI_API_KEY=...

# --- Provider: Groq ----------------------------------------------------------
# SOG_SOURCE=Groq
# SOG_LLM=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...

# --- Provider: AWS Bedrock ---------------------------------------------------
# SOG_SOURCE=Bedrock
# SOG_LLM=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_REGION=us-east-1
# ...then EITHER a bearer token...
# AWS_BEARER_TOKEN_BEDROCK=...
# ...OR a standard access-key pair:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# --- Provider: Custom / local OpenAI-compatible server (vLLM, SGLang, TGI) ----
# SOG_SOURCE=Custom
# SOG_LLM=default
# SOG_CUSTOM_BASE_URL=http://localhost:8000/v1
# SOG_CUSTOM_API_KEY=EMPTY                # omit entirely if your server needs no key

# --- Provider: Ollama (local daemon on :11434, no key) -----------------------
# SOG_SOURCE=Ollama
# SOG_LLM=llama3.1                        # run `ollama pull llama3.1` first

# --- Optional settings (safe defaults shown) ---------------------------------
# SOG_DATA_PATH=./data                    # where datasets are read/written
# SOG_TIMEOUT_SECONDS=600                 # max seconds per agent execution step
# SOG_TOOL_CREATION_ENABLED=false         # let the agent build new tools from GitHub repos
# SOG_SELF_REVIEW_ENABLED=false           # auto-diagnose & repair failed builds/tests
# SOG_MEMORY_ENABLED=false                # advisory memory of prior tool-creation attempts

# --- Optional per-tool credentials (only if you use that specific tool) -------
# PROTOCOLS_IO_ACCESS_TOKEN=...           # full protocols.io method text
# SYNAPSE_AUTH_TOKEN=...                  # controlled Synapse (Sage Bionetworks) downloads
# UCD_TOKEN=...                           # UCDeconvolve cloud deconvolution
# NCBI_EMAIL=you@example.com              # higher-rate NCBI Entrez (identifies you; not secret)
# DREMIO_PAT=...                          # JGI Lakehouse personal token (query_jgi_lakehouse)
# DREMIO_SCHEME=https                     # http only for a Dremio without TLS, and then also:
# DREMIO_ALLOW_PLAINTEXT_TOKEN=0          # 1 accepts sending DREMIO_PAT in cleartext over http
# SOG_CHATNT_REVISION=<commit sha>        # query_chatnt runs ChatNT's remote code only at this reviewed commit
# SOG_LITERATURE_FETCH_TIMEOUT=30         # seconds per socket read (DOI pages, supplementary files)
# SOG_LITERATURE_FETCH_DEADLINE=600       # seconds for one whole fetch, however slowly bytes arrive
# SOG_LITERATURE_MAX_PAGE_MB=64           # largest page read into memory
# SOG_LITERATURE_MAX_DOWNLOAD_MB=1024     # largest supplementary file written to disk
# SOG_SCHOLAR_PROXY_BUDGET_SECONDS=90     # how long query_scholar waits for a working free proxy

# --- Self-repair (agent/spatialomicsgym/agent/env_fallback.py, .../agent/rescue.py) -- both ON by
# default, forced off while SOG_BENCHMARKING_ENABLED is on. The general env is built from
# agent/spatialomicsgym/spatialomicsgym_env/spatialomicsgym_env_general.yml; name its interpreter only
# when it lives somewhere sog_install.constants.general_python() would not look.
# SOG_ENV_FALLBACK_ENABLED=true
# SOG_UNSOLVED_RESCUE_ENABLED=true
# SOG_GENERAL_PYTHON=/opt/conda/envs/spatialomicsgym_env_general/bin/python
# SOG_GENERAL_ENV_MAX_CALLS=12

# Where model-written Python runs. "inprocess" (default; what the CLI, notebooks and every scored
# run use) keeps the REPL in this process. "process" runs every cell in a separate worker process.
# Benchmarking always wins: under SOG_BENCHMARKING_ENABLED=1 the value is ignored.
# SOG_REPL_ISOLATION=inprocess

# The worker's environment is an allowlist. Tool credentials a worker must carry (e.g. UCD_TOKEN,
# SYNAPSE_AUTH_TOKEN) cross only when named here, comma-separated -- a cell can print its environment.
# SOG_AGENT_ENV_ALLOW=

# --- Worker limits -- defaults shown ----------------------------------------------------------------
# The sog-agent worker's thread budget: every OpenMP/BLAS/numba pool in the worker and the tools it launches
# starts with this many threads (unset = min(8, CPU cores)). Its rlimits once boundary init has run:
# processes -- which counts every THREAD of the uid on the box (unset = max(2048, 256 x the thread budget)) --
# and address space in bytes (unset = no address-space cap).
# SOG_AGENT_THREADS=
# SOG_AGENT_NPROC=
# SOG_AGENT_MEMORY_BYTES=
# A YAML of additions to the shipped egress allowlist; read only when owned by root and not group- or
# world-writable.
# SOG_EGRESS_POLICY=/etc/spatialomicsgym/egress_overlay.yaml
# The most figure bytes one cell carries into the transcript (the files it saved are untouched).
# SOG_REPL_MAX_FIGURE_BYTES=16777216
# The Rscript a #!R cell runs with, when the agent's own env has none on PATH (the R tool methods
# run in their own envs regardless). Unset and absent, a #!R cell says R is not installed.
# SOG_RSCRIPT=/opt/conda/envs/<an R env>/bin/Rscript
